{
  "name": "apple-music-discord-bot",
  "version": "1.0.0",
  "description": "Self-hosted Discord music bot that plays Apple Music playlists via Lavalink + LavaSrc",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "deploy-commands:prod": "node dist/deploy-commands.js",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "better-sqlite3": "13.0.3",
    "discord.js": "14.28.1",
    "dotenv": "18.0.10",
    "fuzzball": "2.2.6",
    "lavalink-client": "2.11.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
