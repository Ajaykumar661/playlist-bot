# ---------- Discord ----------
# Bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=your-bot-token-here
# Application ID: Developer Portal > your app > General Information
CLIENT_ID=123456789012345678
# Server ID: enable Developer Mode, right-click your server > Copy Server ID
GUILD_ID=123456789012345678
# Channels where the bot's commands work, comma-separated (right-click a channel > Copy Channel ID).
# Commands used anywhere else get "Use me in #<first channel> 🎵". Applies to everyone, admins included.
# Leave empty to allow every channel.
ALLOWED_CHANNEL_IDS=

# ---------- Lavalink ----------
# Use "localhost" when running the bot with npm. docker-compose overrides it to "lavalink" for the bot container.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
# Any long random string. Lavalink and the bot both read it from here.
LAVALINK_PASSWORD=change-me-to-a-long-random-string

# ---------- Apple Music (LavaSrc) ----------
# Optional. Leave empty and LavaSrc fetches a token from music.apple.com automatically.
APPLE_MUSIC_MEDIA_API_TOKEN=
# Storefront used to read playlists (ISO 3166-1 alpha-2, e.g. in, us, gb)
APPLE_MUSIC_COUNTRY_CODE=in

# ---------- Optional: Deezer (first ISRC resolver) ----------
# Deezer playback needs a master decryption key, which is not distributed publicly.
# Keep DEEZER_ENABLED=false unless you have one. Resolving then starts at YouTube Music.
DEEZER_ENABLED=false
DEEZER_MASTER_DECRYPTION_KEY=
DEEZER_ARL=

# ---------- yt-cipher (required for YouTube playback) ----------
# Shared password between Lavalink and the yt-cipher container. Any long random string.
YT_CIPHER_PASSWORD=change-me-to-another-long-random-string

# ---------- Optional: Spotify links ----------
# Needed for Spotify playlist/album/track links (the anonymous fallback is currently broken).
# Create an app at https://developer.spotify.com/dashboard (README > Spotify).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=IN

# ---------- Optional: YouTube anti-blocking ----------
# See README > Troubleshooting > YouTube blocking
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_OAUTH_SKIP_INIT=true

# ---------- Bot ----------
# trace | debug | info | warn | error
LOG_LEVEL=info
# Volume new players start at (0-150). Above 100 can distort loud songs.
DEFAULT_VOLUME=100
